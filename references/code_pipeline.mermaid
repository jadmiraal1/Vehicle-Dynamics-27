%% TR26 Vehicle Dynamics — code pipeline
%% Renders natively on GitHub, or paste into https://mermaid.live
%% Update this file when the pipeline changes: it versions with the code.
%% Cylinders = generated files (never hand-edit). Dashed = regression guard.

flowchart TD
    subgraph data["Measured data"]
        TTC["TTC_Data/*.mat<br>Calspan R6 / R8 / R9"]
        PNG["tracks/*.png<br>2026 course maps"]
        BM["comp_benchmarks_2026.csv<br>real 2026 results"]
    end

    subgraph fit["Tire fitting (generators)"]
        TF[ttc_fit.m]
        PF[pacejka_fit.m]
        BTC[build_tire_coeffs.m]
    end
    ART[("tire_coeffs.mat<br>generated grip artifact")]

    DIG[tracks/digitize_track.py]
    CSV[("tracks/track_*.csv<br>curvature + provenance header")]
    LTK[load_track.m]

    VP["vehicle_params.m<br>single source of truth<br>(inputs / loaded / derived)"]

    subgraph models["Pure models (nouns, no printing)"]
        LT[load_transfer.m]
        GG[gg_envelope.m]
        CS[corner_speed.m]
        LS[lap_sim.m]
        BIC[bicycle_model.m]
        AX[axle_grip.m]
    end

    subgraph drivers["Target drivers (thin, print T-xxx)"]
        R1[run_load_transfer_targets.m]
        R2[run_gg_targets.m]
        R3[run_handling_targets.m]
        R4[run_lap_targets.m]
        R5[run_energy_strategy.m]
        R6[run_aero_targets.m]
        R7[run_balance_targets.m]
    end

    subgraph pres["Presentation"]
        TR[tire_report.m]
        LR[lap_report.m]
        RP[lap_replay.m]
    end

    subgraph out["Deliverables"]
        PL[plots/*.png]
        CAT[VD_target_catalog.xlsx]
        ACT[aero_component_targets.xlsx]
    end

    ST{{"tests/vd_selftest.m<br>staleness gate + formula recompute"}}

    TTC --> TF & PF
    TF --> BTC
    PF --> BTC
    BTC --> ART --> VP
    PNG --> DIG --> CSV --> LTK

    VP --> LT & GG & LS & BIC & AX
    GG --> CS --> LS

    LT --> R1
    GG --> R2
    BIC --> R3
    AX --> R7
    LS --> R4 & R5 & R6
    LTK --> R4 & R5 & R6 & LR & RP
    BM --> R6
    PF --> TR

    R1 & R2 & R3 & R4 & R5 & R6 & R7 --> PL
    R1 & R2 & R3 & R4 & R5 & R6 & R7 -.-> CAT
    R6 --> ACT
    TR & LR & RP --> PL

    ST -. guards .-> ART
    ST -. guards .-> VP
