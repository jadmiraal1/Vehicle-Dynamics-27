%% Vehicle dynamics toolchain - code pipeline
%% Renders on GitHub, or paste into https://mermaid.live
%% Cylinders = generated files (never hand-edit). Dashed = checks.

flowchart TD
    subgraph data["Inputs"]
        TTC["TTC_Data/*.mat<br>tire test data (licensed, local only)"]
        PNG["tracks/*.png<br>course maps (local only)"]
        BM["organization/comp_benchmarks_2026.csv<br>real competition results"]
        CFG["cars/config_&lt;CAR&gt;.m<br>every property of one car"]
        RUL["util/fsae_rules.m<br>competition constants"]
    end

    subgraph fit["tire/ - fitting (needs TTC_Data)"]
        PF[pacejka_fit.m]
        CF[camber_fit.m]
        BTC[build_tire_coeffs.m]
        TTF["ttc_fit.m<br>screening only"]
    end
    ART[("tire_coeffs_&lt;CAR&gt;.mat<br>fitted tire, hash-stamped")]

    DIG[tracks/digitize_track.py]
    CSV[("tracks/track_*.csv<br>curvature + provenance header")]

    VP["vehicle_params.m + util/vd_derive.m<br>builds p; vd_set for what-ifs"]

    subgraph models["models/ - one operating point"]
        TIRE["mu_of_load / tire_camber / tire_forces"]
        RL[road_loads.m]
        AG["axle_grip.m (lateral, T1)"]
        AXL["ax_limit.m / ax_combined.m (longitudinal, T1)"]
        GG["gg_envelope.m (point mass, T0)"]
        BIC["bicycle_model.m / understeer_at.m"]
        ME[motor_eff.m]
    end

    subgraph lapsim["lapsim/ - over a lap"]
        LT[load_track.m]
        CS[corner_speed.m]
        LS[lap_sim.m]
        AT[accel_time.m]
        DC[lap_duty_cycle.m]
    end

    TGT["targets/run_*.m<br>results + Assumes line"]
    PTS[util/fsae_points.m]
    PL[plots/*.png]

    ST{{"tests/vd_selftest.m<br>staleness + formula recompute"}}
    GLD{{"tests/vd_golden.m<br>every number vs baseline"}}

    TTC --> PF & TTF
    CF --> PF --> BTC --> ART --> VP
    CFG --> VP
    RUL --> VP
    PNG --> DIG --> CSV --> LT

    VP --> TIRE & RL & BIC & ME
    TIRE --> AG & AXL & BIC
    RL --> AG & AXL & GG & DC
    AG --> CS --> LS
    AXL --> LS & AT
    GG --> AXL
    ME --> DC --> LS
    LT --> LS

    LS & AT & AG & AXL & GG & BIC --> TGT
    BM --> PTS --> TGT
    TGT --> PL

    ST -. checks .-> ART
    ST -. checks .-> VP
    GLD -. checks .-> TGT
