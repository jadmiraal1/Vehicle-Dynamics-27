# FSAE TTC data is licensed to registered teams only - never commit or
# redistribute it. Copy TTC_Data/ from the team drive; without it vd_selftest
# skips the tire-staleness check and says so.
TTC_Data/

# Datasheets and internal documents (copyright / size) stay on the team
# drive. Only the pipeline diagram is tracked.
references/*
!references/code_pipeline.mermaid

# MATLAB litter
*.asv
*.autosave
slprj/

# Office lock files
~$*

# OS litter
.DS_Store
Thumbs.db
desktop.ini

# Generated figures (reproduced by the run_* scripts)
plots/

# Trackers, releases and reports live on the team drive. The benchmarks CSV
# is tracked because the points model reads it.
organization/*
!organization/comp_benchmarks_2026.csv
/*.xlsx
/VD_toolchain_roadmap.md

# Track source scans and previews (the digitized CSVs the code reads ARE tracked)
tracks/*.png
tracks/__pycache__/
